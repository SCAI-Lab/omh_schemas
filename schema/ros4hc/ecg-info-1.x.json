{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ECG Data Series",
    "type": "object",
    "description": "This schema represents an ecg data series, i.e., an array of measures that share the same header.",
    "definitions": {
        "header": {
            "$ref": "metadata/sensor-device-header-1.x.json"
        },
        "ecg_body": {
            "$ref": "ecg-1.x.json"
        },
        "filter_base": {
            "$ref": "filters/filter-base-1.x.json"
        }
    },
    "properties": {
        "header": {
            "description": "The header of the data point.",
            "type": "object",
            "allOf": [
                {
                    "$ref": "#/definitions/header"
                },
                {
                    "type": "object",
                    "properties": {
                        "ecg_info": {
                            "type": "object",
                            "properties": {
                                "units": {
                                    "type": "string",
                                    "enum": [
                                        "mV",
                                        "uV",
                                        "counts"
                                    ]
                                },
                                "electrode_placement": {
                                    "description": "Support multiple placements",
                                    "type": "array",
                                    "items": {
                                        "type": "string",
                                        "enum": [
                                            "limb",
                                            "wrist_ankle",
                                            "chest",
                                            "torso",
                                            "abdomen",
                                            "back",
                                            "ear",
                                            "neck",
                                            "left_arm",
                                            "right_arm",
                                            "left_leg",
                                            "right_leg",
                                            "custom"
                                        ]
                                    }
                                },
                                "lead_type": {
                                    "description": "Standard ECG lead names according to clinical conventions (12-lead), one per channel.",
                                    "url": "https://en.wikipedia.org/wiki/Electrocardiography#12-lead_ECG",
                                    "type": "array",
                                    "items": {
                                        "type": "string",
                                        "enum": [
                                            "I",
                                            "II",
                                            "III",
                                            "aVR",
                                            "aVL",
                                            "aVF",
                                            "V1",
                                            "V2",
                                            "V3",
                                            "V4",
                                            "V5",
                                            "V6",
                                            "custom"
                                        ]
                                    }
                                },
                                "filters": {
                                    "$ref": "#/definitions/filter_base"
                                }
                            },
                            "required": [
                                "electrode_placement"
                            ]
                        }
                    }
                }
            ]
        },
        "body": {
            "$ref": "#/definitions/ecg_body"
        }
    },
    "required": [
        "header",
        "body"
    ]
}